# --- Security & Secrets ---
# NEVER commit your API keys. This is the #1 mistake juniors make.
.env
.env.local

# --- Python Environment ---
# Your virtual environment is huge and machine-specific. Others should build their own.
venv/
env/
.venv/
bin/
lib/
include/

# --- Python Artifacts ---
# These are generated by Python as it runs. They don't belong in Git.
__pycache__/
*.py[cod]
*$py.class
.pytest_cache/

# --- AI & Database (Week 2 Specific) ---
# Don't commit your local vector database. It can grow to GBs.
# We commit the logic to build it, not the database itself.
chromadb_store/
/chroma/
*.sqlite3

# --- Raw Data ---
# For privacy and storage, keep raw PDFs out of the repo.
# Tip: Provide a 'knowledge_base/sample.pdf' for others to test.
knowledge_base/

# --- IDE & System ---
.vscode/
.idea/
.DS_Store
Thumbs.db